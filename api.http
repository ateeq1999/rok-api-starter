@baseUrl = http://localhost:3000
@token = {{auth_login.response.body.token}}


### Register a new user
# @name auth_register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123",
  "password_confirmation": "password123"
}


### Login
# @name auth_login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}


### Get current user profile
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}


### Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{token}}


### Request password reset
POST {{baseUrl}}/auth/forgot-password
Content-Type: application/json

{
  "email": "test@example.com"
}


### Reset password
POST {{baseUrl}}/auth/reset-password
Content-Type: application/json

{
  "token": "reset-token-from-email",
  "password": "newpassword123",
  "password_confirmation": "newpassword123"
}


### Request magic link
POST {{baseUrl}}/auth/magic-link
Content-Type: application/json

{
  "email": "test@example.com"
}


### Magic link callback (replace token)
GET {{baseUrl}}/auth/magic-link/callback?token=your-magic-link-token


### List all users (admin)
GET {{baseUrl}}/api/v1/users
Authorization: Bearer {{token}}


### Create user (admin)
POST {{baseUrl}}/api/v1/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "newuser@example.com",
  "password": "password123"
}


### Get user by ID
GET {{baseUrl}}/api/v1/users/1
Authorization: Bearer {{token}}


### Update user email
PUT {{baseUrl}}/api/v1/users/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "updated@example.com"
}


### Delete user
DELETE {{baseUrl}}/api/v1/users/1
Authorization: Bearer {{token}}
